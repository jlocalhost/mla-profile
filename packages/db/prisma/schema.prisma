datasource db {
  provider = "postgresql"
  url      = env("DB_CONNECTION_STRING")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model CountryState {
  id                  Int      @id @default(autoincrement())
  name                String?  @db.VarChar
  createdAt           DateTime @map("created_at")
  updatedAt           DateTime @map("updated_at")
  stateCode           String?  @map("state_code") @db.VarChar
  isDeleted           Boolean? @default(false) @map("is_deleted")
  latitude            Float?
  longitude           Float?
  zoom                Float?
  preferences         Json     @default("{}")
  deletedAt           DateTime? @map("deleted_at")
  capital             String?  @db.VarChar
  svgPath             String?  @map("svg_path") @db.VarChar
  outerSvgPath        String?  @map("outer_svg_path") @db.VarChar
  officeAddress       String?  @map("office_address") @db.VarChar
  levelWiseDeletion   Json?    @default("{}") @map("level_wise_deletion")
  emblem              String?  @db.VarChar
  isDummy             Boolean? @default(false) @map("is_dummy")

  assemblyConstituencies AssemblyConstituency[]

  @@map("country_states")
}

model AssemblyConstituency {
  id                          Int       @id @default(autoincrement())
  name                        String?   @db.VarChar
  countryStateId              Int?      @map("country_state_id")
  createdAt                   DateTime  @map("created_at")
  updatedAt                   DateTime  @map("updated_at")
  number                      Int?
  parliamentaryConstituencyId Int?      @map("parliamentary_constituency_id")
  isDeleted                   Boolean?  @default(false) @map("is_deleted")
  categoryType                String?   @map("category_type") @db.VarChar
  metadata                    Json?
  totalPopulation             Int?      @map("total_population")
  totalVoters                 Int?      @map("total_voters")
  deletedAt                   DateTime? @map("deleted_at")
  mappings                    Json      @default("{}")
  mappingUpdatedAt            DateTime? @map("mapping_updated_at")
  isDummy                     Boolean?  @default(false) @map("is_dummy")

  countryState                CountryState? @relation(fields: [countryStateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mlaInformation              MlaInformation[]
  mlaSocialMedia              MlaSocialMedia[]
  previousElectionResults     PreviousElectionResult[]

  @@index([countryStateId])
  @@index([deletedAt])
  @@index([parliamentaryConstituencyId])
  @@map("assembly_constituencies")
}

model MlaInformation {
  id                  Int       @id @default(autoincrement())
  assemblyConstituencyId Int?   @map("ac_id")
  name                String?   @db.VarChar
  caste               String?   @db.VarChar
  category            String?   @db.VarChar
  adName              String?   @map("ad_name") @db.VarChar
  partyName           String?   @map("party_name") @db.VarChar
  age                 Int?
  qualification       String?   @db.VarChar
  occupation          String?   @db.VarChar
  politicalBackground String?   @map("political_background") @db.Text
  familyMembers       Json?     @map("family_members")
  politicalJourney    String?   @map("political_journey") @db.Text
  acGrade             String?   @map("ac_grade") @db.VarChar
  totalVoters         Int?      @map("total_voters")
  maleVoters          Int?      @map("male_voters")
  femaleVoters        Int?      @map("female_voters")
  lastAeTurnout       Float?    @map("last_ae_turnout")
  
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  assemblyConstituency AssemblyConstituency? @relation(fields: [assemblyConstituencyId], references: [id])

  @@index([assemblyConstituencyId])
  @@map("mla_information")
}

model MlaSocialMedia {
  id                  Int       @id @default(autoincrement())
  assemblyConstituencyId Int?   @map("ac_id")
  platform            String?   @db.VarChar
  profileLink         String?   @map("profile_link") @db.VarChar
  accountVerified     Boolean?  @default(false) @map("account_verified")
  followers           String?   @db.VarChar
  posts               Int?
  engagement          String?   @db.VarChar
  overallRating       Float?    @map("overall_rating")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  assemblyConstituency AssemblyConstituency? @relation(fields: [assemblyConstituencyId], references: [id])

  @@index([assemblyConstituencyId])
  @@map("mla_social_media")
}

model PreviousElectionResult {
  id                  Int       @id @default(autoincrement())
  assemblyConstituencyId Int?   @map("ac_id")
  electionYear        Int?      @map("election_year")
  electionType        String?   @map("election_type") @db.VarChar
  candidate           String?   @db.VarChar
  candidateCaste      String?   @map("candidate_caste") @db.VarChar
  party               String?   @db.VarChar
  votes               Int?      @map("votes_get")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  assemblyConstituency AssemblyConstituency? @relation(fields: [assemblyConstituencyId], references: [id])

  @@index([assemblyConstituencyId])
  @@map("previous_election_results")
}
